#!/bin/bash -e

ROOT=`dirname $0`

cd "$ROOT/.."

SKIP_TRANSLATIONS=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-translations)
      SKIP_TRANSLATIONS=true
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$SKIP_TRANSLATIONS" = false ]; then
  echo "Updating translations..."
  if ! [ -d packages/desktop-client/locale ]; then
      git clone https://github.com/actualbudget/translations packages/desktop-client/locale
  fi
  pushd packages/desktop-client/locale > /dev/null
  git checkout .
  git pull
  popd > /dev/null
  packages/desktop-client/bin/remove-untranslated-languages
fi

# Regenerate the English catalogue from source strings. locale/ is gitignored,
# so a stale en.json can silently drop a newly added key; react-i18next then
# fetches it at runtime, t changes identity, and initAll() remounts open modals
# (resetting their state). Do this every build — it is cheap and idempotent —
# after the translations clone so it overwrites en.json with current keys.
echo "Generating i18n..."
yarn generate:i18n

lage build:browser --to=@actual-app/web
